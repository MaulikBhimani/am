---
interface Props {
  number: string;
  name: string;
  description: string;
  href: string;
  imageSrc?: string;
  imageAlt?: string;
}
const { number, name, description, href, imageSrc, imageAlt } = Astro.props;
---
<a
  href={href}
  class="group relative flex flex-col bg-[#151C21] border border-white/10 overflow-hidden transition-all duration-300 hover:border-white/20"
  aria-label={`${name} — ${description}`}
>
  <div class="relative aspect-[4/3] overflow-hidden bg-[#1B2328]">
    {imageSrc ? (
      <img
        src={imageSrc}
        alt={imageAlt ?? name}
        width="400"
        height="300"
        loading="lazy"
        decoding="async"
        class="w-full h-full object-cover opacity-70 transition-transform duration-300 group-hover:scale-[1.03]"
      />
    ) : (
      <div class="w-full h-full flex items-center justify-center">
        <svg width="48" height="48" viewBox="0 0 48 48" fill="none" aria-hidden="true" class="opacity-20">
          <rect x="4" y="4" width="40" height="40" stroke="#F97316" stroke-width="1"/>
          <circle cx="24" cy="24" r="12" stroke="#F97316" stroke-width="1"/>
          <line x1="24" y1="4" x2="24" y2="44" stroke="#F97316" stroke-width="0.5"/>
          <line x1="4" y1="24" x2="44" y2="24" stroke="#F97316" stroke-width="0.5"/>
        </svg>
      </div>
    )}
    <div class="absolute top-0 left-0 right-0 h-0.5 bg-[#F97316] scale-x-0 group-hover:scale-x-100 transition-transform duration-300 origin-left"></div>
    <svg class="absolute top-2 right-2 w-6 h-6 opacity-30" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M24 0H12V12" stroke="#F97316" stroke-width="1"/>
    </svg>
  </div>

  <div class="p-5 flex flex-col flex-1">
    <div class="flex items-start justify-between mb-3">
      <span class="text-xs text-[#F97316]/60 font-mono">{number}</span>
    </div>
    <h3 class="text-sm font-600 text-[#F4F5F2] uppercase tracking-wide mb-2" style="font-family: var(--font-heading); letter-spacing: 0.08em">{name}</h3>
    <p class="text-xs text-[#AAB4BA] leading-relaxed flex-1 mb-4">{description}</p>
    <div class="flex items-center gap-2 text-xs text-[#F97316] font-medium" style="font-family: var(--font-heading)">
      <span>Explore</span>
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" class="transition-transform duration-200 group-hover:translate-x-1.5">
        <path d="M2 7h10M8 3l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </div>
  </div>
</a>
