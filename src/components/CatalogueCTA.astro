---
---
<section class="py-24 bg-[#11171B]" aria-labelledby="catalogue-heading">
  <div class="container">
    <div class="grid lg:grid-cols-2 gap-12 items-center">
      <div class="reveal">
        <div class="flex items-center gap-3 mb-4">
          <span class="block w-6 h-px bg-[#F97316]"></span>
          <span class="text-xs text-[#F97316] tracking-widest uppercase" style="font-family: var(--font-heading); letter-spacing: 0.18em">Product Catalogue</span>
        </div>
        <h2 id="catalogue-heading" class="text-2xl lg:text-4xl font-700 text-[#F4F5F2] mb-4" style="font-family: var(--font-heading)">
          Explore Our Industrial Product Range
        </h2>
        <p class="text-[#AAB4BA] text-sm leading-relaxed mb-8">
          Browse our full catalogue of industrial products — welding, motors, gears, conveyor systems, electrical panels and more.
        </p>
        <div class="flex flex-wrap gap-4">
          <a
            href="/catalogue/company-catalogue.pdf"
            download
            class="inline-flex items-center gap-2 px-6 py-3 bg-[#F97316] text-white text-sm font-medium hover:bg-[#FF8A1F] transition-colors duration-200"
            style="font-family: var(--font-heading)"
          >
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M8 2v8M5 7l3 3 3-3M2 12h12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            Download Catalogue
          </a>
          <a href="/products/" class="inline-flex items-center gap-2 px-6 py-3 border border-white/20 text-[#F4F5F2] text-sm font-medium hover:border-white/40 transition-colors duration-200" style="font-family: var(--font-heading)">
            View Products
          </a>
        </div>
        <p class="mt-4 text-xs text-[#AAB4BA]/40">[Catalogue PDF — placeholder until actual catalogue is available]</p>
      </div>

      <!-- Visual -->
      <div class="reveal hidden lg:block" style="transition-delay: 0.1s">
        <div class="relative border border-white/10 p-8 bg-[#151C21]">
          <svg class="w-full h-48 opacity-20" viewBox="0 0 400 200" fill="none" aria-hidden="true">
            <rect x="1" y="1" width="398" height="198" stroke="#F97316" stroke-width="0.5"/>
            <line x1="0" y1="40" x2="400" y2="40" stroke="#F97316" stroke-width="0.5"/>
            <line x1="0" y1="80" x2="400" y2="80" stroke="#F97316" stroke-width="0.5"/>
            <line x1="0" y1="120" x2="400" y2="120" stroke="#F97316" stroke-width="0.5"/>
            <line x1="0" y1="160" x2="400" y2="160" stroke="#F97316" stroke-width="0.5"/>
            <line x1="80" y1="0" x2="80" y2="200" stroke="#F97316" stroke-width="0.5"/>
            <line x1="160" y1="0" x2="160" y2="200" stroke="#F97316" stroke-width="0.5"/>
            <line x1="240" y1="0" x2="240" y2="200" stroke="#F97316" stroke-width="0.5"/>
            <line x1="320" y1="0" x2="320" y2="200" stroke="#F97316" stroke-width="0.5"/>
            <circle cx="200" cy="100" r="60" stroke="#F97316" stroke-width="0.5" stroke-dasharray="4 8"/>
            <text x="200" y="105" text-anchor="middle" fill="#F97316" font-size="12" font-family="monospace">CATALOGUE</text>
          </svg>
        </div>
      </div>
    </div>
  </div>
</section>
