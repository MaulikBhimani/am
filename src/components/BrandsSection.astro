---
const brands = ['Mangalam', 'Vulcan Welding', 'Yuri Smart Engineering', 'Crompton', 'Bharat Bijlee'];
---
<section class="py-16 bg-[#11171B] border-y border-white/10" aria-labelledby="brands-heading">
  <div class="container">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-6 mb-10 reveal">
      <h2 id="brands-heading" class="text-xl font-600 text-[#F4F5F2]" style="font-family: var(--font-heading)">Brands We Supply</h2>
      <p class="text-xs text-[#AAB4BA]/60">Available for supply — not claimed as official partnerships unless verified.</p>
    </div>

    <!-- Static for screen readers -->
    <ul class="sr-only" aria-label="Available brands">
      {brands.map(b => <li>{b}</li>)}
    </ul>

    <!-- Visual brand strip -->
    <div class="flex flex-wrap gap-px bg-white/5 reveal" aria-hidden="true">
      {brands.map(brand => (
        <div class="flex-1 min-w-[160px] bg-[#11171B] px-8 py-6 flex items-center justify-center border border-transparent hover:border-white/10 transition-colors duration-200 group">
          <span class="text-sm font-600 text-[#AAB4BA] group-hover:text-[#F4F5F2] transition-colors duration-200 text-center" style="font-family: var(--font-heading)">{brand}</span>
        </div>
      ))}
    </div>
  </div>
</section>
