---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import TrustStrip from '../components/TrustStrip.astro';
import AboutSection from '../components/AboutSection.astro';
import ProductCategories from '../components/ProductCategories.astro';
import FeaturedProducts from '../components/FeaturedProducts.astro';
import BrandsSection from '../components/BrandsSection.astro';
import ManufacturingSection from '../components/ManufacturingSection.astro';
import WhyUs from '../components/WhyUs.astro';
import Applications from '../components/Applications.astro';
import EnquiryCTA from '../components/EnquiryCTA.astro';
import CatalogueCTA from '../components/CatalogueCTA.astro';
import ContactSection from '../components/ContactSection.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
---
<BaseLayout>
  <Header />
  <main id="main-content">
    <Hero />
    <TrustStrip />
    <AboutSection />
    <ProductCategories />
    <FeaturedProducts />
    <BrandsSection />
    <ManufacturingSection />
    <WhyUs />
    <Applications />
    <EnquiryCTA />
    <CatalogueCTA />
    <ContactSection />
  </main>
  <Footer />
</BaseLayout>
