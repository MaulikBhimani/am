---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import PageHero from "../../components/PageHero.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import ProductCategories from "../../components/ProductCategories.astro";
import "../../styles/global.css";

const categories = (await getCollection("categories")).sort(
  (a, b) => a.data.order - b.data.order,
);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Industrial Products",
  description:
    "Browse our full range of industrial products including welding, motors, gears, conveyor belts and electrical panels.",
  url: Astro.url.href,
  breadcrumb: {
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Home",
        item: Astro.url.origin,
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "Products",
        item: Astro.url.href,
      },
    ],
  },
};
---

<BaseLayout
  title="Industrial Products — Welding, Motors, Gears, Conveyor Belts | AM Industrial"
  description="Browse our full range of industrial products: welding rods, welding machines, cutting discs, motors, gears, conveyor belts, electrical panels and manufactured components."
>
  <script
    type="application/ld+json"
    slot="head"
    set:html={JSON.stringify(jsonLd)}
  />

  <Header />

  <main id="main-content">

    <Breadcrumb
      crumbs={[
        { label: "Home", href: "/" },
        { label: "Products" }
      ]}
    />

    <!-- <PageHero
      eyebrow="Product Range"
      title="Industrial Products"
      subtitle="Products selected for demanding industrial applications — welding, power transmission, material handling, electrical and more."
      noPadTop
    /> -->


    <!-- =====================================================
         TRADING PRODUCTS
    ====================================================== -->

    <section class="py-16 lg:py-20 bg-[#0B0F12]">
      <div class="container">

        <!-- Section heading -->
        <div class="mb-10 lg:mb-12 flex flex-col lg:flex-row lg:items-end lg:justify-between gap-4">

          <div>
            <span
              class="text-[10px] uppercase tracking-[0.2em] text-[#F97316]"
              style="font-family:var(--font-heading)"
            >
              Trading Products
            </span>

            <h2
              class="mt-2 text-2xl lg:text-3xl font-700 text-[#F4F5F2]"
              style="font-family:var(--font-heading)"
            >
              Industrial Products
            </h2>
          </div>

          <p class="max-w-md text-xs lg:text-sm leading-relaxed text-[#AAB4BA]">
            Products selected for demanding industrial applications including
            welding, power transmission, material handling and electrical systems.
          </p>

        </div>


        <!-- Product grid -->
        <div
          class="grid sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-px bg-white/5"
        >

          {
            categories.map((cat) => (
              <a
                href={`/products/${cat.data.slug}/`}
                class="group bg-[#0B0F12] flex flex-col border border-transparent hover:border-white/10 transition-all duration-300"
              >

                <!-- Image -->
                <div class="relative aspect-[4/3] overflow-hidden bg-[#151C21]">

                  {cat.data.image && (
                    <img
                      src={cat.data.image}
                      alt={cat.data.name}
                      width="400"
                      height="300"
                      loading="lazy"
                      decoding="async"
                      class="w-full h-full object-cover opacity-70 transition-transform duration-500 group-hover:scale-[1.04]"
                    />
                  )}

                  <div
                    class="absolute inset-x-0 top-0 h-0.5 bg-[#F97316] scale-x-0 group-hover:scale-x-100 transition-transform duration-300 origin-left"
                  />

                </div>


                <!-- Content -->
                <div class="p-5 lg:p-6 flex flex-col flex-1">

                  <h3
                    class="text-sm font-600 text-[#F4F5F2] mb-2"
                    style="font-family:var(--font-heading)"
                  >
                    {cat.data.name}
                  </h3>

                  <p class="text-xs text-[#AAB4BA] leading-relaxed flex-1 mb-5">
                    {cat.data.description}
                  </p>

                  <div
                    class="flex items-center gap-2 text-xs text-[#F97316]"
                    style="font-family:var(--font-heading)"
                  >
                    <span>View products</span>

                    <svg
                      width="12"
                      height="12"
                      viewBox="0 0 12 12"
                      fill="none"
                      class="transition-transform duration-200 group-hover:translate-x-1"
                    >
                      <path
                        d="M2 6h8M6 2l4 4-4 4"
                        stroke="currentColor"
                        stroke-width="1.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                  </div>

                </div>

              </a>
            ))
          }

        </div>

      </div>
    </section>


    <!-- =====================================================
         MANUFACTURING
    ====================================================== -->

    <!-- <ProductCategories /> -->


    <!-- =====================================================
         ENQUIRY CTA
    ====================================================== -->

    <section class="py-16 lg:py-20 bg-[#11171B] border-t border-white/10">
      <div class="container text-center">

        <h2
          class="text-xl lg:text-2xl font-700 text-[#F4F5F2] mb-3"
          style="font-family:var(--font-heading)"
        >
          Can't find what you need?
        </h2>

        <p class="text-[#AAB4BA] text-sm mb-6">
          Send us your requirement and we'll help identify the right product.
        </p>

        <a
          href="/enquiry/"
          class="inline-flex items-center gap-2 px-6 py-3 bg-[#F97316] text-white text-sm font-medium hover:bg-[#FF8A1F] transition-colors"
          style="font-family:var(--font-heading)"
        >
          Send Enquiry
        </a>

      </div>
    </section>

  </main>

  <Footer />

</BaseLayout>
