---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageHero from '../../components/PageHero.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import '../../styles/global.css';

// Pre-fill categories from Astro content collection
const categories = (await getCollection('categories')).sort((a, b) => a.data.order - b.data.order);
const whatsapp = import.meta.env.PUBLIC_WHATSAPP_NUMBER || '';
---

<BaseLayout
  title="Product Enquiry — AM Industrial"
  description="Send a product enquiry to AM Industrial. Describe your requirement and we will respond with availability, specifications and pricing."
>
  <Header />
  <main id="main-content">
    <Breadcrumb crumbs={[{ label: 'Home', href: '/' }, { label: 'Enquiry' }]} />
    <PageHero
      eyebrow="Enquiry"
      title="Send Your Requirement"
      subtitle="Describe what you need and we will respond with availability, specifications and pricing."
      tight
    />

    <section class="py-16 bg-[#0B0F12]">
      <div class="container">
        <div class="grid lg:grid-cols-3 gap-12">

          <!-- Form — 2 cols -->
          <div class="lg:col-span-2">
            <form id="enquiry-form" novalidate class="space-y-5" aria-label="Product enquiry form">
              
              <div class="grid sm:grid-cols-2 gap-5">
                {[
                  { id: 'name', label: 'Name', type: 'text', required: true, autocomplete: 'name' },
                  { id: 'company', label: 'Company', type: 'text', required: false, autocomplete: 'organization' },
                  { id: 'phone', label: 'Phone', type: 'tel', required: false, autocomplete: 'tel' },
                  { id: 'email', label: 'Email', type: 'email', required: true, autocomplete: 'email' },
                ].map((f) => (
                  <div>
                    <label for={f.id} class="block text-xs text-[#AAB4BA] mb-1.5" style="font-family:var(--font-heading)">
                      {f.label}{f.required && <span class="text-[#F97316] ml-0.5" aria-hidden="true">*</span>}
                    </label>
                    <input type={f.type} id={f.id} name={f.id} required={f.required} autocomplete={f.autocomplete}
                      class="w-full bg-[#151C21] border border-white/10 text-[#F4F5F2] text-sm px-4 py-3 focus:outline-none focus:border-[#F97316] transition-colors placeholder:text-[#AAB4BA]/20"/>
                  </div>
                ))}
              </div>

              <div>
                <label for="category" class="block text-xs text-[#AAB4BA] mb-1.5" style="font-family:var(--font-heading)">Product Category</label>
                <select id="category" name="category" class="w-full bg-[#151C21] border border-white/10 text-[#F4F5F2] text-sm px-4 py-3 focus:outline-none focus:border-[#F97316] transition-colors">
                  <option value="">Select a category (optional)</option>
                  {categories.map((cat) => (
                    <option value={cat.data.name}>{cat.data.name}</option>
                  ))}
                </select>
              </div>

              <div>
                <label for="product" class="block text-xs text-[#AAB4BA] mb-1.5" style="font-family:var(--font-heading)">
                  Product / Requirement <span class="text-[#F97316]" aria-hidden="true">*</span>
                </label>
                <input type="text" id="product" name="product" required
                  class="w-full bg-[#151C21] border border-white/10 text-[#F4F5F2] text-sm px-4 py-3 focus:outline-none focus:border-[#F97316] transition-colors placeholder:text-[#AAB4BA]/20"
                  placeholder="Product name, specification or description"/>
              </div>

              <div>
                <label for="message" class="block text-xs text-[#AAB4BA] mb-1.5" style="font-family:var(--font-heading)">Additional Details</label>
                <textarea id="message" name="message" rows="5"
                  class="w-full bg-[#151C21] border border-white/10 text-[#F4F5F2] text-sm px-4 py-3 focus:outline-none focus:border-[#F97316] transition-colors resize-none placeholder:text-[#AAB4BA]/20"
                  placeholder="Quantity, application, delivery location or any other relevant details"></textarea>
              </div>

              <!-- Basic Math CAPTCHA Field -->
              <div class="p-4 bg-[#151C21] border border-white/10">
                <label for="captcha-answer" class="block text-xs text-[#AAB4BA] mb-2" style="font-family:var(--font-heading)">
                  Security Verification: <span id="captcha-question" class="font-bold text-[#F97316]"></span> <span class="text-[#F97316]">*</span>
                </label>
                <input type="number" id="captcha-answer" required placeholder="Enter answer"
                  class="w-full bg-[#0B0F12] border border-white/10 text-[#F4F5F2] text-sm px-4 py-2 focus:outline-none focus:border-[#F97316] transition-colors placeholder:text-[#AAB4BA]/20"/>
              </div>

              <!-- Honeypot Bot Field -->
              <div class="hidden" aria-hidden="true">
                <input type="text" name="website" id="website" tabindex="-1" autocomplete="off"/>
              </div>

              <div id="enquiry-status" role="status" aria-live="polite" class="text-sm hidden"></div>

              <button type="submit" id="submit-btn" class="w-full px-6 py-3 bg-[#F97316] text-white text-sm font-medium hover:bg-[#FF8A1F] transition-colors focus:outline-none focus:ring-2 focus:ring-[#F97316] focus:ring-offset-2 focus:ring-offset-[#0B0F12]" style="font-family:var(--font-heading)">
                Send Enquiry
              </button>
            </form>
          </div>

          <!-- Sidebar -->
          <div class="space-y-6">
            <div class="p-6 bg-[#151C21] border border-white/10">
              <h2 class="text-sm font-600 text-[#F4F5F2] mb-4" style="font-family:var(--font-heading)">What happens next?</h2>
              <ol class="space-y-4">
                {[
                  'We receive your enquiry and review your requirement.',
                  'We respond with product availability, specifications and pricing.',
                  'On confirmation, we arrange supply or manufacturing.',
                ].map((step, i) => (
                  <li class="flex gap-3">
                    <span class="text-xs text-[#F97316] font-mono mt-0.5 flex-shrink-0">{String(i+1).padStart(2,'0')}</span>
                    <p class="text-xs text-[#AAB4BA] leading-relaxed">{step}</p>
                  </li>
                ))}
              </ol>
            </div>

            {whatsapp && (
              <div class="p-6 bg-[#151C21] border border-white/10">
                <p class="text-xs text-[#AAB4BA] mb-3">Prefer to message directly?</p>
                <a href={`https://wa.me/${whatsapp}`} target="_blank" rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 text-sm text-[#F4F5F2] hover:text-[#F97316] transition-colors" style="font-family:var(--font-heading)">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="text-[#F97316]" aria-hidden="true">
                    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
                  </svg>
                  WhatsApp Us
                </a>
              </div>
            )}
          </div>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>

<script>
  // Math CAPTCHA Generator Logic
  let correctAnswer = 0;

  function generateCaptcha() {
    const num1 = Math.floor(Math.random() * 9) + 1;
    const num2 = Math.floor(Math.random() * 9) + 1;
    correctAnswer = num1 + num2;
    const qEl = document.getElementById('captcha-question');
    if (qEl) {
      qEl.textContent = `What is ${num1} + ${num2}?`;
    }
  }

  // Generate question on page load
  generateCaptcha();

  // Pre-fill fields from URL query params
  const params = new URLSearchParams(window.location.search);
  const productParam = params.get('product');
  const brandParam = params.get('brand');
  if (productParam) {
    const el = document.getElementById('product') as HTMLInputElement;
    if (el) el.value = productParam;
  }
  if (brandParam) {
    const el = document.getElementById('product') as HTMLInputElement;
    if (el && !el.value) el.value = brandParam + ' products';
  }

  // Handle Form Submit
  const form = document.getElementById('enquiry-form') as HTMLFormElement;
  const status = document.getElementById('enquiry-status')!;
  const btn = document.getElementById('submit-btn') as HTMLButtonElement;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    // Honeypot validation
    const honeypot = (document.getElementById('website') as HTMLInputElement)?.value;
    if (honeypot) return;

    // Validate inputs
    const name = (document.getElementById('name') as HTMLInputElement)?.value.trim();
    const email = (document.getElementById('email') as HTMLInputElement)?.value.trim();
    const product = (document.getElementById('product') as HTMLInputElement)?.value.trim();
    const userAnswer = parseInt((document.getElementById('captcha-answer') as HTMLInputElement)?.value.trim(), 10);

    if (!name || !email || !product) {
      status.textContent = 'Please fill in all required fields (*).';
      status.className = 'text-sm text-red-400';
      status.classList.remove('hidden');
      return;
    }

    // Math CAPTCHA validation
    if (isNaN(userAnswer) || userAnswer !== correctAnswer) {
      status.textContent = 'Incorrect security verification answer. Please try again.';
      status.className = 'text-sm text-red-400';
      status.classList.remove('hidden');
      generateCaptcha(); // Refresh question on wrong answer
      (document.getElementById('captcha-answer') as HTMLInputElement).value = '';
      return;
    }

    btn.disabled = true;
    btn.textContent = 'Sending…';

    try {
      const formData = new FormData(form);

      // Submit data to Google Sheets
      await fetch("https://script.google.com/macros/s/AKfycbxDwLN2f1yWxDoLQRV5l0obbQVdSZwBm2bPb-ai6WOD-c_kVWysmNfJgjuA--_A1P4/exec", {
        method: 'POST',
        body: formData,
        mode: 'no-cors'
      });

      status.textContent = 'Enquiry submitted successfully! We will contact you soon.';
      status.className = 'text-sm text-green-400';
      form.reset();
      generateCaptcha(); // Reset captcha for next submission
    } catch (err) {
      status.textContent = 'Something went wrong. Please try again.';
      status.className = 'text-sm text-red-400';
    } finally {
      status.classList.remove('hidden');
      btn.disabled = false;
      btn.textContent = 'Send Enquiry';
    }
  });
</script>