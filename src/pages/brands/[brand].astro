---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageHero from '../../components/PageHero.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import '../../styles/global.css';

export async function getStaticPaths() {
  const brands = await getCollection('brands');
  return brands.map((brand) => ({ params: { brand: brand.data.slug }, props: { brand } }));
}

const { brand } = Astro.props;
const { Content } = await render(brand);

const allProducts = await getCollection('products');
const brandProducts = allProducts.filter(
  (p) => p.data.brand?.toLowerCase().replace(/\s+/g, '-') === brand.data.slug && p.data.available
);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Brand',
  name: brand.data.name,
  description: brand.data.description,
  url: Astro.url.href,
};
---
<BaseLayout
  title={`${brand.data.name} — Industrial Products | AM Industrial`}
  description={brand.data.description}
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />
  <Header />
  <main id="main-content">
    <Breadcrumb crumbs={[
      { label: 'Home', href: '/' },
      { label: 'Brands', href: '/brands/' },
      { label: brand.data.name },
    ]} />
    <PageHero eyebrow="Brand" title={brand.data.name} subtitle={brand.data.description} />

    <section class="py-16 bg-[#0B0F12]">
      <div class="container">
        <div class="max-w-2xl mb-12 text-[#AAB4BA] text-sm leading-relaxed space-y-4">
          <Content />
          <p class="text-xs text-[#F4F5F2]/40">Brand names are trademarks of their respective owners. Listed as available for supply.</p>
        </div>

        {brandProducts.length > 0 && (
          <>
            <h2 class="text-lg font-600 text-[#F4F5F2] mb-6" style="font-family:var(--font-heading)">{brand.data.name} Products</h2>
            <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-px bg-white/5">
              {brandProducts.map((product) => (
                <a
                  href={`/products/${product.data.category}/${product.data.slug}/`}
                  class="group bg-[#0B0F12] flex flex-col border border-transparent hover:border-white/10 transition-all duration-250"
                >
                  <div class="relative aspect-[4/3] overflow-hidden bg-[#151C21]">
                    {product.data.images[0] && (
                      <img src={product.data.images[0]} alt={product.data.name} width="600" height="450" loading="lazy" decoding="async" class="w-full h-full object-cover opacity-60 transition-transform duration-300 group-hover:scale-[1.03]"/>
                    )}
                    <div class="absolute top-0 left-0 right-0 h-0.5 bg-[#F97316] scale-x-0 group-hover:scale-x-100 transition-transform duration-300 origin-left"></div>
                  </div>
                  <div class="p-6 flex flex-col flex-1">
                    <h3 class="text-sm font-600 text-[#F4F5F2] mb-2" style="font-family:var(--font-heading)">{product.data.name}</h3>
                    <p class="text-xs text-[#AAB4BA] leading-relaxed flex-1 mb-4">{product.data.shortDescription}</p>
                    <span class="text-xs text-[#F97316] flex items-center gap-1 group-hover:gap-2 transition-all" style="font-family:var(--font-heading)">
                      View details
                      <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M2 6h8M6 2l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </span>
                  </div>
                </a>
              ))}
            </div>
          </>
        )}
      </div>
    </section>

    <section class="py-12 bg-[#11171B] border-t border-white/10">
      <div class="container text-center">
        <p class="text-sm text-[#AAB4BA] mb-4">Looking for a specific {brand.data.name} product?</p>
        <a href={`/enquiry/?brand=${encodeURIComponent(brand.data.name)}`} class="inline-flex items-center gap-2 px-6 py-3 bg-[#F97316] text-white text-sm font-medium hover:bg-[#FF8A1F] transition-colors" style="font-family:var(--font-heading)">
          Send Enquiry
        </a>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
